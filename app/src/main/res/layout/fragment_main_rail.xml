<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navigationRailContainer"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The open forum, in place of the app title and buttons -->
            <com.github.borz7zy.shadowgram.ui.views.ChatHeaderView
                android:id="@+id/forumHeaderView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="16dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsMaterialButton"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/title_activity_settings"
                android:tooltipText="@string/title_activity_settings"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/storiesMaterialButton"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                tools:icon="@drawable/ic_cast"
                android:text="@string/stories_material_button_appbar" />

            <com.github.borz7zy.shadowgram.ui.cells.AppTitleCell
                android:id="@+id/appTitleCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- The voice or video message playing, left the chat it's in -->
        <com.github.borz7zy.shadowgram.ui.views.PlaybackBarView
            android:id="@+id/playbackBarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/contentCoordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navigationRailContainer"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mainSectionContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include layout="@layout/main_fab_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/navigationRailContainer"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hideNavigationRailButton"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/chat_hide_navigation"
            android:visibility="gone"
            app:icon="@drawable/ic_side_panel_close" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/foldersRailScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

            <com.github.borz7zy.shadowgram.ui.views.ChatFolderRailView
                android:id="@+id/chatFolderRailView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/foldersRailDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="?attr/colorOutlineVariant"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.github.borz7zy.shadowgram.ui.views.WrapContentNavigationRailView
            android:id="@+id/navigationBarView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:menu="@menu/navigation_bar_view_fragment_main"
            app:menuGravity="center"
            app:paddingBottomSystemWindowInsets="false"
            app:paddingTopSystemWindowInsets="false" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/compactNavigationHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/navigationRailContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/showNavigationRailButton"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/chat_show_navigation"
            app:icon="@drawable/ic_side_panel_open" />
    </FrameLayout>

    <include layout="@layout/main_fab_menu_rail_scrims" />

    <include
        layout="@layout/main_search_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

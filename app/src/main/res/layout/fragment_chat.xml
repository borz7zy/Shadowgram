<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:transitionGroup="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/chat_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface">

            <!-- Opens the profile, its avatar is shared with it -->
            <com.github.borz7zy.shadowgram.ui.views.ChatHeaderView
                android:id="@+id/chatHeaderView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:paddingEnd="16dp" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- The pinned message closest above what's on screen: shows it, the button lists all -->
        <LinearLayout
            android:id="@+id/pinnedLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.github.borz7zy.shadowgram.ui.views.PinnedIndicatorView
                android:id="@+id/pinnedIndicatorView"
                android:layout_width="3dp"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pinnedTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    tools:text="Pinned message #2" />

                <TextView
                    android:id="@+id/pinnedTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Hello there" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pinnedListMaterialButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/chat_pinned_messages"
                android:tooltipText="@string/chat_pinned_messages"
                app:icon="@drawable/ic_list" />

        </LinearLayout>

        <!-- The voice or video message playing -->
        <com.github.borz7zy.shadowgram.ui.views.PlaybackBarView
            android:id="@+id/playbackBarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.github.borz7zy.shadowgram.ui.views.TopRoundedLayout
        android:id="@+id/chatCardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"
        app:cornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <com.github.borz7zy.shadowgram.ui.recyclerview.RecyclerListView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    tools:listitem="@layout/message_bubble_item" />

                <LinearLayout
                    android:id="@+id/noElementsLinearLayout"
                    style="@style/Theme.Shadowgram.NoElements.LinearLayout"
                    android:layout_gravity="center"
                    android:visibility="gone">

                    <TextView
                        style="@style/Theme.Shadowgram.NoElements.TextView"
                        android:text="@string/shrug"
                        android:textAppearance="?attr/textAppearanceDisplayMedium" />

                    <Space style="@style/Theme.Shadowgram.NoElements.Space" />

                    <TextView
                        style="@style/Theme.Shadowgram.NoElements.TextView"
                        android:text="@string/chat_no_messages" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/linearProgressIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <!-- To the oldest unseen reaction, to the oldest unread mention, to the newest
                     message: the last one shows while scrolling down away from it -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/reactionsFrameLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:minWidth="56dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/reactionsFloatingActionButton"
                            style="?attr/floatingActionButtonSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/chat_unread_reactions"
                            android:tooltipText="@string/chat_unread_reactions"
                            app:srcCompat="@drawable/ic_favorite" />

                        <TextView
                            android:id="@+id/reactionsCountTextView"
                            style="@style/Theme.Shadowgram.Chat.FabBadge"
                            tools:text="3" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mentionsFrameLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:minWidth="56dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/mentionsFloatingActionButton"
                            style="?attr/floatingActionButtonSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/chat_unread_mentions"
                            android:tooltipText="@string/chat_unread_mentions"
                            app:srcCompat="@drawable/ic_alternate_email" />

                        <TextView
                            android:id="@+id/mentionsCountTextView"
                            style="@style/Theme.Shadowgram.Chat.FabBadge"
                            tools:text="3" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/scrollDownFrameLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:minWidth="56dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/scrollDownFloatingActionButton"
                            style="?attr/floatingActionButtonSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/chat_scroll_down"
                            android:tooltipText="@string/chat_scroll_down"
                            app:srcCompat="@drawable/ic_keyboard_arrow_down" />

                        <TextView
                            android:id="@+id/scrollDownCountTextView"
                            style="@style/Theme.Shadowgram.Chat.FabBadge"
                            tools:text="3" />

                    </FrameLayout>

                </LinearLayout>

                <!-- A long press on send: when the message goes, like the new chat menu -->
                <View
                    android:id="@+id/sendMenuScrimView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@color/fab_menu_scrim"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/sendMenuLinearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendLaterMaterialButton"
                        style="@style/Theme.Shadowgram.FabMenu.Action"
                        android:text="@string/chat_send_later"
                        app:icon="@drawable/ic_schedule"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendWhenOnlineMaterialButton"
                        style="@style/Theme.Shadowgram.FabMenu.Action"
                        android:text="@string/chat_send_when_online"
                        app:icon="@drawable/ic_person"
                        tools:visibility="visible" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout android:id="@+id/selectionActionsLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="12dp" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/selectionForwardButton"
                    style="?attr/materialButtonTonalStyle" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/selection_forward" app:icon="@drawable/ic_forward" />
                <com.google.android.material.button.MaterialButton android:id="@+id/selectionReplyButton"
                    style="?attr/materialButtonTonalStyle" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/selection_reply" app:icon="@drawable/ic_reply" />
            </LinearLayout>
            <LinearLayout android:id="@+id/channelMuteContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/channelMuteButton"
                    style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="64dp"
                    android:text="@string/chat_mute" />
            </LinearLayout>

            <!-- The composer and the panel under it that takes the keyboard's place -->
            <LinearLayout
                android:id="@+id/composerLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_composer_bar_background"
                android:orientation="vertical">

                <!-- Members to mention, bot commands or inline bot results for what is typed -->
                <com.github.borz7zy.shadowgram.ui.recyclerview.RecyclerListView
                    android:id="@+id/suggestionsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceContainer"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- The message the next one replies to -->
                <LinearLayout
                    android:id="@+id/replyLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/composerContextIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_reply"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/replyTitleTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary"
                            tools:text="Reply to Pavel" />

                        <TextView
                            android:id="@+id/replyTextTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Hello there" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelReplyMaterialButton"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/message_cancel_reply"
                        android:tooltipText="@string/message_cancel_reply"
                        app:icon="@drawable/ic_close" />

                </LinearLayout>

                <!-- Files picked for the next message -->
                <com.github.borz7zy.shadowgram.ui.composer.AttachmentStripView
                    android:id="@+id/attachmentStripView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Round Material 3 attachment control. -->
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/attachMaterialButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/chat_attach_button_background"
                        android:contentDescription="@string/chat_attach"
                        android:padding="0dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mms_compose_attach"
                        android:tooltipText="@string/chat_attach"
                        android:tint="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:background="@drawable/chat_compose_field_background"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/messageEditText"
                                android:saveEnabled="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/chat_message_hint"
                                android:importantForAutofill="no"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLines="5"
                                android:minHeight="40dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="8dp"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />


                            <!-- The bots' commands, only while the chat has some and nothing is typed -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/botCommandsMaterialButton"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                android:contentDescription="@string/chat_bot_commands"
                                android:tooltipText="@string/chat_bot_commands"
                                android:visibility="gone"
                                app:icon="@drawable/ic_terminal" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/emojiMaterialButton"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                android:contentDescription="@string/chat_emoji"
                                android:tooltipText="@string/chat_emoji"
                                app:icon="@drawable/ic_mood" />

                            <!-- Only while the chat has scheduled messages -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/scheduledMaterialButton"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                android:contentDescription="@string/chat_scheduled_messages"
                                android:tooltipText="@string/chat_scheduled_messages"
                                android:visibility="gone"
                                app:icon="@drawable/ic_schedule" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendMaterialButton"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="@string/chat_send"
                        android:enabled="false"
                        android:textAlignment="center"
                        android:tooltipText="@string/chat_send"
                        android:visibility="gone"
                        app:icon="@drawable/ic_mms_send_enabled"
                        app:iconGravity="textStart"
                        app:iconSize="40dp"
                        app:iconTint="@null" />

                    <!-- Takes the send button's place while there is nothing to send -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/videoNoteMaterialButton"
                        style="?attr/materialIconButtonFilledTonalStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:contentDescription="@string/chat_voice_note"
                        android:textAlignment="center"
                        android:tooltipText="@string/chat_voice_note"
                        app:icon="@drawable/ic_mms_send_disabled"
                        app:iconGravity="textStart"
                        app:iconSize="24dp"
                        app:cornerRadius="20dp" />

                </LinearLayout>

                <com.github.borz7zy.shadowgram.ui.views.TopRoundedLayout
                    android:id="@+id/panelCardView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:background="?attr/colorSurfaceContainerLow"
                    app:cornerRadius="28dp">

                    <com.github.borz7zy.shadowgram.ui.composer.StickerKeyboardView
                        android:id="@+id/stickerKeyboardView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:id="@+id/attachmentPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.github.borz7zy.shadowgram.ui.composer.GalleryPanelView
                            android:id="@+id/galleryPanelView"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.github.borz7zy.shadowgram.ui.composer.AttachPanelView
                            android:id="@+id/attachPanelView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </com.github.borz7zy.shadowgram.ui.views.TopRoundedLayout>

            </LinearLayout>

        </LinearLayout>

    </com.github.borz7zy.shadowgram.ui.views.TopRoundedLayout>

</LinearLayout>

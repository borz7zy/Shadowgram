<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/previewFrameLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Both cameras' previews, the inactive one transparent (not gone: its surface stays) -->
    <FrameLayout
        android:id="@+id/previewFrameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/video_note_preview_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="240dp"
        app:layout_constraintHeight_max="240dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/backPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <androidx.camera.view.PreviewView
            android:id="@+id/frontPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/controlsLinearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelMaterialButton"
            style="?attr/materialIconButtonFilledTonalStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/video_note_cancel"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:tooltipText="@string/video_note_cancel"
            app:icon="@drawable/ic_close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flipCameraMaterialButton"
            style="?attr/materialIconButtonFilledTonalStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:contentDescription="@string/video_note_flip_camera"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:tooltipText="@string/video_note_flip_camera"
            app:icon="@drawable/ic_flip_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendMaterialButton"
            style="?attr/materialIconButtonFilledStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/chat_send"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:tooltipText="@string/chat_send"
            app:icon="@drawable/ic_send" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<!-- A voice message or music in its bubble: play/pause, the song, the seek bar and the time -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="240dp"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playPauseMaterialButton"
        style="?attr/materialIconButtonFilledStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/playback_play"
        app:icon="@drawable/ic_play_arrow" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Music only: the song and its performer -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:visibility="gone"
            tools:text="Song — Performer"
            tools:visibility="visible" />

        <com.google.android.material.slider.Slider
            android:id="@+id/seekSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/playback_voice_message"
            android:enabled="false"
            android:valueFrom="0"
            android:valueTo="1"
            app:labelBehavior="gone"
            app:thumbHeight="24dp"
            app:trackHeight="8dp" />

        <TextView
            android:id="@+id/timeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="0:12 / 0:30" />

    </LinearLayout>

</merge>

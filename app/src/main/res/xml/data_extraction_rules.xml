<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Telegram sessions, messages and media never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="accounts/" />
        <exclude domain="sharedpref" path="accounts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts/" />
        <exclude domain="sharedpref" path="accounts.xml" />
    </device-transfer>
</data-extraction-rules>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:key="settings_home">

    <PreferenceScreen
        app:icon="@drawable/ic_person"
        app:key="settings_accounts"
        app:summary="@string/settings_accounts_summary"
        app:title="@string/accounts_header">

        <PreferenceCategory
            app:key="settings_current_accounts"
            app:title="@string/settings_current_accounts" />

        <PreferenceCategory
            app:key="settings_account_actions"
            app:title="@string/settings_account_actions">

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:icon="@drawable/ic_person_add"
                app:key="add_account"
                app:summary="@string/settings_add_account_summary"
                app:title="@string/add_account">

                <intent
                    android:targetClass="com.github.borz7zy.shadowgram.AuthActivity"
                    android:targetPackage="com.github.borz7zy.shadowgram">

                    <extra
                        android:name="add_account"
                        android:value="true" />

                </intent>

            </com.github.borz7zy.shadowgram.ui.SettingsActionPreference>

        </PreferenceCategory>

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_smartphone"
        app:key="settings_interface"
        app:summary="@string/fullscreen_mode"
        app:title="@string/settings_interface_header">

        <PreferenceCategory
            app:key="settings_screen"
            app:title="@string/settings_screen_header">

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="false"
                app:icon="@drawable/ic_expand_content"
                app:key="fullscreen_mode"
                app:summary="@string/fullscreen_mode_summary"
                app:title="@string/fullscreen_mode" />

        </PreferenceCategory>

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_notifications"
        app:key="settings_notifications"
        app:summary="@string/notifications_summary"
        app:title="@string/notifications_header">

        <PreferenceScreen
            app:icon="@drawable/ic_person"
            app:key="notifications_private"
            app:title="@string/notifications_private" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_groups"
            app:title="@string/notifications_groups" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_channels"
            app:title="@string/notifications_channels" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_stories"
            app:title="@string/notifications_stories" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_reactions"
            app:title="@string/notifications_reactions" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_exceptions"
            app:title="@string/notifications_exceptions" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_story_exceptions"
            app:title="@string/notifications_story_exceptions" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:key="notifications_communities"
            app:title="@string/notifications_communities" />

        <PreferenceScreen
            app:icon="@drawable/ic_headphones"
            app:key="notifications_sounds"
            app:summary="@string/notifications_sounds_summary"
            app:title="@string/notifications_sounds">

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:icon="@drawable/ic_notifications"
                app:key="notifications_app_sound"
                app:persistent="false"
                app:summary="@string/notifications_app_sound_summary"
                app:title="@string/notifications_app_sound"
                app:widgetLayout="@layout/settings_section_arrow" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:icon="@drawable/ic_headphones"
                app:key="notifications_app_sound_preview"
                app:persistent="false"
                app:title="@string/notifications_app_sound_preview" />

            <PreferenceCategory
                app:key="notifications_telegram_sounds"
                app:title="@string/notifications_telegram_sounds" />

        </PreferenceScreen>

        <PreferenceScreen
            app:icon="@drawable/ic_settings"
            app:key="notifications_other"
            app:title="@string/notifications_other" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:isPreferenceVisible="false"
            app:key="notifications_chat"
            app:title="@string/notifications_header" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:isPreferenceVisible="false"
            app:key="notifications_story_chat"
            app:title="@string/notifications_stories" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:isPreferenceVisible="false"
            app:key="notifications_topics"
            app:title="@string/notifications_header" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:isPreferenceVisible="false"
            app:key="notifications_topic"
            app:title="@string/notifications_header" />

        <PreferenceScreen
            app:icon="@drawable/ic_notifications"
            app:isPreferenceVisible="false"
            app:key="notifications_community"
            app:title="@string/notifications_header" />

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_headphones"
        app:key="settings_audio"
        app:summary="@string/settings_audio_summary"
        app:title="@string/settings_audio_header">

        <PreferenceCategory
            app:key="settings_playback"
            app:title="@string/settings_playback_header">

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:icon="@drawable/ic_audiofx"
                app:key="enable_offload"
                app:summary="@string/enable_offload_summary"
                app:title="@string/enable_offload" />

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:icon="@drawable/ic_high_res"
                app:key="enable_float_output"
                app:summary="@string/enable_float_output_summary"
                app:title="@string/enable_float_output" />

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:icon="@drawable/ic_pause"
                app:key="stop_playback_on_task_removed"
                app:summary="@string/stop_playback_on_task_removed_summary"
                app:title="@string/stop_playback_on_task_removed" />

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="false"
                app:icon="@drawable/ic_skip_next"
                app:key="skip_silence"
                app:summary="@string/skip_silence_summary"
                app:title="@string/skip_silence" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="settings_local_media"
            app:title="@string/settings_local_media_header">

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:icon="@drawable/ic_delete"
                app:key="reset_local_stats"
                app:title="@string/reset_local_stats" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:icon="@drawable/ic_sync"
                app:key="rescan_media_store"
                app:title="@string/rescan_media_store" />

        </PreferenceCategory>

        <PreferenceCategory
            app:key="settings_experimental"
            app:title="@string/experimental_header">

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="false"
                app:icon="@drawable/ic_usb"
                app:key="split_local_devices"
                app:summary="@string/split_local_devices_summary"
                app:title="@string/split_local_devices" />

        </PreferenceCategory>

    </PreferenceScreen>


    <PreferenceScreen
        app:icon="@drawable/ic_audiofx"
        app:key="settings_haptics"
        app:summary="@string/haptics_overview"
        app:title="@string/haptics_title">

        <PreferenceCategory app:title="@string/haptics_playback_title">

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="false"
                app:key="audio_haptics_enabled"
                app:title="@string/haptics_title" />

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:dependency="audio_haptics_enabled"
                app:key="audio_haptics_notifications"
                app:title="@string/haptics_notifications" />

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:dependency="audio_haptics_enabled"
                app:key="audio_haptics_media"
                app:title="@string/haptics_media" />

            <ListPreference
                app:defaultValue="1"
                app:entries="@array/haptics_profile_names"
                app:entryValues="@array/haptics_profile_values"
                app:key="audio_haptics_profile"
                app:title="@string/haptics_profile" />

            <SeekBarPreference
                android:max="100"
                app:defaultValue="75"
                app:key="audio_haptics_intensity"
                app:showSeekBarValue="true"
                app:title="@string/haptics_intensity" />

            <SeekBarPreference
                android:max="400"
                app:defaultValue="200"
                app:key="audio_haptics_offset"
                app:seekBarIncrement="10"
                app:title="@string/haptics_offset" />

        </PreferenceCategory>

        <PreferenceCategory app:title="@string/haptics_preparation">

            <com.github.borz7zy.shadowgram.ui.SettingsSwitchPreference
                app:defaultValue="true"
                app:key="audio_haptics_automatic"
                app:title="@string/haptics_automatic" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_import"
                app:title="@string/haptics_import" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_current"
                app:title="@string/haptics_current" />

            <Preference
                app:key="haptics_status"
                app:selectable="false"
                app:title="@string/haptics_status" />

            <Preference
                app:key="haptics_notification_status"
                app:selectable="false"
                app:title="@string/haptics_notification_status" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_cancel"
                app:title="@string/haptics_cancel" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_sound_settings"
                app:title="@string/haptics_sound_settings" />

        </PreferenceCategory>

        <PreferenceCategory app:title="@string/haptics_storage_title">

            <Preference
                app:key="haptics_stats"
                app:selectable="false"
                app:title="@string/haptics_stats" />

            <ListPreference
                app:defaultValue="32"
                app:entries="@array/haptics_limit_names"
                app:entryValues="@array/haptics_limit_values"
                app:key="audio_haptics_limit"
                app:title="@string/haptics_limit" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_clean"
                app:title="@string/haptics_clean" />

            <com.github.borz7zy.shadowgram.ui.SettingsActionPreference
                app:key="haptics_rebuild"
                app:title="@string/haptics_rebuild" />

        </PreferenceCategory>

    </PreferenceScreen>

</PreferenceScreen>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_chat"
    app:startDestination="@id/chatFragment">

    <!-- Twelve's now playing screen and what it opens, for the chat's playlist -->
    <include app:graph="@navigation/fragment_chat_picker" />
    <include app:graph="@navigation/fragment_lyrics" />
    <include app:graph="@navigation/fragment_now_playing" />
    <include app:graph="@navigation/fragment_now_playing_stats_bottom_sheet_dialog" />
    <include app:graph="@navigation/fragment_playback_control_bottom_sheet_dialog" />
    <include app:graph="@navigation/fragment_queue" />

    <!-- The bar of what plays, under the top bars (PlaybackBarView) -->
    <action
        android:id="@+id/action_global_fragment_now_playing"
        app:destination="@id/fragment_now_playing"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.ChatFragment"
        tools:layout="@layout/fragment_chat">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="topic_id"
            android:defaultValue="0"
            app:argType="integer" />

        <action
            android:id="@+id/action_chatFragment_to_videoNoteDialogFragment"
            app:destination="@id/videoNoteDialogFragment" />

        <!-- A tap on a photo -->
        <action
            android:id="@+id/action_chatFragment_to_photoViewerDialogFragment"
            app:destination="@id/photoViewerDialogFragment" />

        <!-- A tap on a message -->
        <action
            android:id="@+id/action_chatFragment_to_messageMenuDialogFragment"
            app:destination="@id/messageMenuDialogFragment" />

        <!-- The top bar, a sender's name or avatar -->
        <action
            android:id="@+id/action_chatFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <!-- A long press on the top bar, the pinned bar's list button -->
        <action
            android:id="@+id/action_chatFragment_to_chatSearchFragment"
            app:destination="@id/chatSearchFragment" />

        <!-- The scheduled messages button in the composer -->
        <action
            android:id="@+id/action_chatFragment_to_scheduledChatFragment"
            app:destination="@id/scheduledChatFragment" />

    </fragment>

    <fragment
        android:id="@+id/chatSearchFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.ChatSearchFragment"
        tools:layout="@layout/fragment_chat_search">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="topic_id"
            android:defaultValue="0"
            app:argType="integer" />

        <!-- The pinned messages rather than a search -->
        <argument
            android:name="pinned"
            android:defaultValue="false"
            app:argType="boolean" />

    </fragment>

    <!-- The chat's scheduled messages: the same screen without the composer. Its actions have
         the chat's ids, so the screen opens them the same way -->
    <fragment
        android:id="@+id/scheduledChatFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.ChatFragment"
        tools:layout="@layout/fragment_chat">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="topic_id"
            android:defaultValue="0"
            app:argType="integer" />

        <argument
            android:name="scheduled"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_chatFragment_to_photoViewerDialogFragment"
            app:destination="@id/photoViewerDialogFragment" />

        <action
            android:id="@+id/action_chatFragment_to_messageMenuDialogFragment"
            app:destination="@id/messageMenuDialogFragment" />

        <action
            android:id="@+id/action_chatFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

    </fragment>

    <dialog
        android:id="@+id/videoNoteDialogFragment"
        android:name="com.github.borz7zy.shadowgram.videonote.VideoNoteDialogFragment"
        tools:layout="@layout/fragment_video_note">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="topic_id"
            android:defaultValue="0"
            app:argType="integer" />

    </dialog>

    <!-- The chat's photos, from the one tapped -->
    <dialog
        android:id="@+id/photoViewerDialogFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.PhotoViewerDialogFragment"
        tools:layout="@layout/fragment_photo_viewer">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="message_id"
            app:argType="long" />

        <!-- The photos of its message to page through, an album's -->
        <argument
            android:name="message_ids"
            app:argType="long[]" />

    </dialog>

    <!-- The message lifted over the blurred chat: reactions above, actions below -->
    <dialog
        android:id="@+id/messageMenuDialogFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.MessageMenuDialogFragment"
        tools:layout="@layout/fragment_message_menu">

        <argument
            android:name="chat_id"
            app:argType="long" />

        <argument
            android:name="message_id"
            app:argType="long" />

        <!-- What "Copy" copies, null for none -->
        <argument
            android:name="text"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <!-- A scheduled message: "Send now" and no reactions -->
        <argument
            android:name="scheduled"
            android:defaultValue="false"
            app:argType="boolean" />

        <!-- "Forward": the menu is still the current destination when the chat gets it, and
             goes away by itself for the picker -->
        <action
            android:id="@+id/action_messageMenuDialogFragment_to_fragment_chat_picker"
            app:destination="@id/fragment_chat_picker" />

    </dialog>

    <!-- A profile is another destination of the chat pane, including its member profiles. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.github.borz7zy.shadowgram.fragments.ProfileFragment"
        tools:layout="@layout/fragment_profile">

        <argument android:name="chat_id" app:argType="long" />
        <argument
            android:name="is_from_chat"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_profileFragment_to_profileActivity"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_photoViewerDialogFragment"
            app:destination="@id/photoViewerDialogFragment" />

    </fragment>

</navigation>
